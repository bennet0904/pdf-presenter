# Subdomain des Servers. Nur nötig für den Caddy aus compose.yaml (Profil "caddy").
CRASH_DOMAIN=

# Mail-Benachrichtigung. Leer lassen = keine Mails, Berichte werden trotzdem gespeichert.
# Das Passwort gehört NICHT hierher, sondern in smtp_password.txt (Docker-Secret).
CRASH_MAIL_TO=
CRASH_MAIL_FROM=
CRASH_SMTP_HOST=
CRASH_SMTP_PORT=587
# starttls (Port 587), ssl (Port 465) oder none
CRASH_SMTP_SECURITY=starttls
CRASH_SMTP_USER=
# Neue Absturzursachen kommen sofort, bekannte höchstens alle N Stunden (0 = jede)
CRASH_MAIL_REPEAT_HOURS=24

# Grenzen gegen Missbrauch
CRASH_PER_IP_HOUR=20
CRASH_PER_DAY=2000
